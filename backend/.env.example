# ==============================================================================
# ATLAS-001 TELEMETRY SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your local Wi-Fi and API settings.
# ==============================================================================

# Server Settings
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# API Key Authentication
API_KEY=your_secure_api_key_here
REQUIRE_API_KEY=false

# Wi-Fi Network Configuration (for ESP32 / hardware client)
WIFI_SSID=Your_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password

# Telemetry Target Endpoint
API_BASE_URL=http://localhost:5000

# Device Metadata
DEVICE_ID=ATLAS-001
TRANSPORT=WIFI
DEVICE_MODE=REAL
